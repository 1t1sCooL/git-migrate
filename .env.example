# --- Профили (рекомендуемый способ) ---------------------------------------
# Источник: рабочий GitLab (откуда фетчим репозитории)
SOURCE_GITLAB_BASE_URL=https://gitlab.mycompany.com
SOURCE_GITLAB_TOKEN=glpat_xxxxxxxxx
SOURCE_GITLAB_GROUP_ID=

# Источник: GitHub (для направления GitHub -> GitLab)
SOURCE_GITHUB_TOKEN=
SOURCE_GITHUB_OWNER=
SOURCE_GITHUB_OWNER_TYPE=user

# Назначение: личный GitLab (куда бекапим)
DEST_GITLAB_BASE_URL=https://gitlab.com
DEST_GITLAB_TOKEN=glpat_xxxxxxxxx
DEST_GITLAB_NAMESPACE_ID=

# Назначение: личный GitHub (куда бекапим)
DEST_GITHUB_TOKEN=github_pat_xxxxxxxxx
DEST_GITHUB_OWNER=my-user
DEST_GITHUB_OWNER_TYPE=user

# --- Легаси-переменные (упрощённый вариант) --------------------------------
# Если SOURCE_*/DEST_* не заданы, используются эти значения для обеих сторон.
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=glpat_xxxxxxxxx
GITLAB_GROUP_ID=
GITLAB_TARGET_NAMESPACE_ID=

GITHUB_TOKEN=github_pat_xxxxxxxxx
GITHUB_OWNER=my-org-or-user
GITHUB_OWNER_TYPE=user

# --- Поведение --------------------------------------------------------------
MIGRATION_DIRECTION=

USE_ORIGINAL_REPO_NAME=true
PRESERVE_SOURCE_OWNER_AS_GITLAB_GROUP=true
PRESERVE_NAMESPACE_IN_NAME=false
INCLUDE_ARCHIVED=false
# Фильтры обнаружения: glob-шаблоны полного пути через запятую (exclude побеждает)
# Примеры: REPO_INCLUDE_PATTERNS=team/*  REPO_EXCLUDE_PATTERNS=*/sandbox-*,archive/*
REPO_INCLUDE_PATTERNS=
REPO_EXCLUDE_PATTERNS=
MIGRATE_LFS=false
INTERACTIVE_NAMING=true
# Имена в режиме sync: false — group__sub__project (без коллизий), true — только имя проекта
SYNC_FLAT_NAMES=false
DRY_RUN=true
MIRROR_ROOT=./mirrors
LOG_LEVEL=info
